# Root environment template for NyayaSetu AI

# Backend Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/nyayasetu
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=4
ENVIRONMENT=development

# Vercel Blob private storage (production)
BLOB_READ_WRITE_TOKEN=

# AI provider configuration (PART 2 integration points)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Dataset configuration (Sumitedu/indian-case-laws)
HF_DATASET_ID=Sumitedu/indian-case-laws
HF_DATASET_CONFIG=default
HF_DATASET_SPLIT=train
HF_DATASET_STREAMING=true
HF_IMPORT_LIMIT=100
HF_IMPORT_BATCH_SIZE=100
HF_IMPORT_RESUME=true

# Text indexing settings
HF_INDEXING_LIMIT=100
HF_INDEXING_BATCH_SIZE=25

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional seed data
SEED_DEMO_DATA=false

